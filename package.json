{
  "name": "@otwdesign/plugin-otp",
  "version": "1.0.0",
  "description": "Two-step sign-in and one-time codes for OTW CMS: an authenticator app, email, SMS (Twilio or your own service) or WhatsApp, for signing in and for any form.",
  "license": "Apache-2.0",
  "author": "OTW SRL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTWSRL/otw-plugin-otp.git"
  },
  "homepage": "https://github.com/OTWSRL/otw-plugin-otp#readme",
  "bugs": {
    "url": "https://github.com/OTWSRL/otw-plugin-otp/issues"
  },
  "keywords": [
    "otw-cms-plugin",
    "otw-cms",
    "cms",
    "plugin",
    "otp",
    "2fa",
    "two-factor",
    "totp",
    "authenticator",
    "sms",
    "twilio",
    "one-time-password",
    "whatsapp"
  ],
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "exports": {
    ".": "./src/index.tsx",
    "./admin": "./src/admin.tsx",
    "./field": "./src/field.tsx"
  },
  "files": [
    "src",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter ./site dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p . && pnpm --filter ./site typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter ./site test:e2e",
    "test:all": "pnpm check && pnpm test:e2e",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-plugin-version.mjs",
    "release": "changeset publish"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "@otwdesign/admin-ui": "^1.8.0",
    "@otwdesign/sdk": "^1.8.0",
    "drizzle-orm": ">=0.45.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@otwdesign/admin-ui": "link:../nextjs-cms/packages/admin-ui",
    "@otwdesign/core": "link:../nextjs-cms/packages/core",
    "@otwdesign/sdk": "link:../nextjs-cms/packages/sdk",
    "@otwdesign/testing": "link:../nextjs-cms/packages/testing",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-orm": "link:../nextjs-cms/packages/core/node_modules/drizzle-orm",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "next": "^16.4.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
